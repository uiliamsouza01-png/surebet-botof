# Copie este arquivo para ".env" (ou configure como "Variables"
# no painel da hospedagem) e preencha com seus dados.

# Token do bot, gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# Deixe em branco no primeiro deploy. Depois de rodar o bot e mandar
# /start, ele te devolve o chat_id certo — cole aqui e reinicie.
TELEGRAM_CHAT_ID=

# Chave gratuita da The Odds API (the-odds-api.com)
ODDS_API_KEY=

# Esportes monitorados, separados por vírgula
SPORTS=soccer_brazil_campeonato,soccer_epl,basketball_nba

# Regiões de casas de apostas: us, uk, eu, au (pode combinar: eu,uk)
REGIONS=eu,uk

# Lucro mínimo (%) para disparar um alerta
MIN_PROFIT_PERCENT=1.0

# Intervalo entre varreduras, em minutos
SCAN_INTERVAL_MINUTES=10

# Valor de banca usado só pra exemplo de divisão de stake no alerta
STAKE_EXAMPLE=1000
